# Example environment file — copy to `.env` and fill in actual values.
# DO NOT commit `.env` to git (already in .gitignore).

# Monad Testnet RPC endpoint (default: public Monad testnet RPC)
MONAD_RPC=https://testnet-rpc.monad.xyz

# Monad Testnet chain id (10143 by default)
MONAD_CHAIN_ID=10143

# Monad Testnet explorer base URL (for verify + read contract)
MONAD_EXPLORER=https://testnet.monadexplorer.com

# Wallet private key (蒋平's Testnet-only wallet; NEVER use a mainnet key here)
# 0x-prefixed 64-hex-char private key
PRIVATE_KEY=

# (optional) Etherscan-like API key for source verification on Monad explorer
# Most explorers don't require this for Testnet; leave blank if so.
MONAD_EXPLORER_API_KEY=
